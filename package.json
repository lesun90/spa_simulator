{
  "name": "steerlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:check": "tsc --noEmit && vite build --outDir /tmp/steerlab-dist --emptyOutDir",
    "assets:import": "vite-node scripts/importAssets.ts",
    "assets:road-reimport": "vite-node scripts/reimportRoadTilesFromObj.ts",
    "assets:road-wfc": "vite-node scripts/generateRoadTileWfcMetadata.ts",
    "assets:road-topology": "vite-node scripts/retagRoadTopology.ts",
    "assets:road-wfc:verify": "vite-node scripts/verifyRoadWfc.ts",
    "wfc:world-plan:verify": "vite-node scripts/verifyWorldPlanCorpus.ts",
    "assets:thumbnails": "vite-node scripts/generateAssetThumbnails.ts",
    "scene:export": "vite-node scripts/exportEnvironment.ts",
    "test": "vitest"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "stats.js": "^0.17.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/stats.js": "^0.17.4",
    "@types/three": "0.185.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  }
}
